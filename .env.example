# Application Environment Variables Example

# Backend Configuration
LLM_PROVIDER=gemini                     # Options: 'gemini' (local dev/test) | 'bedrock' (AWS prod)
GEMINI_API_KEY=your_gemini_api_key_here # Required when LLM_PROVIDER=gemini
GEMINI_MODEL_ID=gemini-2.5-flash         # Gemini Model ID (default: gemini-2.5-flash)

BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0 # AWS Bedrock Model ID
AWS_REGION=ap-south-1                   # AWS Region for DynamoDB & Bedrock

PRICE_PROVIDER=yahoo                    # Options: 'yahoo' (live free provider) | 'mock' (local deterministic)

# DynamoDB Configuration
HOLDINGS_TABLE=PortfolioHoldings
TARGETS_TABLE=PortfolioTargetAllocation
SNAPSHOTS_TABLE=PortfolioSnapshots

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api
